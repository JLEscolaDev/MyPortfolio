<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Cargo Lift — Spatial Prototype</title>

    <!-- Page-scoped styles (metal + space look). Desktop intact; móvil optimizado más abajo -->
    <style>
    :root{
        --bg1:#0a0c10;
        --bg2:#121620;
        --metal:linear-gradient(145deg,#8a8f9b 0%, #cfd3da 20%, #9aa1ac 50%, #dfe3ea 80%, #9aa1ac 100%);
        --accent:#00d0ff;
        --accent-2:#8a7bff;
        --card-bg:rgba(255,255,255,0.05);
        --stroke:rgba(255,255,255,0.18);
        --glow:0 0 24px rgba(0,208,255,.25), 0 0 64px rgba(138,123,255,.2);

        /* Alturas máximas pensadas para no “comerse” la pantalla */
        --max-gallery-video-h: 520px;   /* escritorio */
        --max-single-video-h: 720px;    /* escritorio */
    }
    html,body{margin:0; padding:0; background: radial-gradient(1200px 800px at 10% -10%, #162033 0%, transparent 60%), radial-gradient(900px 700px at 90% 10%, #1a0f2c 0%, transparent 60%), var(--bg1); color:#e8edf6; font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }

    /* Header */
    .nav {
        position: sticky; top: 0; z-index: 40;
        display:flex; align-items:center; gap:12px;
        padding: 12px 20px;
        background: linear-gradient(180deg, rgba(10,12,16,.85), rgba(10,12,16,.65) 60%, transparent);
        backdrop-filter: blur(6px);
        border-bottom: 1px solid var(--stroke);
    }
    .back-btn{
        appearance:none; border:1px solid var(--stroke); color:#e8edf6; background:var(--card-bg);
        padding:8px 14px; border-radius:999px; cursor:pointer;
        transition:transform .15s ease, box-shadow .2s ease, border-color .2s ease;
        box-shadow: var(--glow);
    }
    .back-btn:hover{ transform: translateY(-1px); border-color: rgba(0,208,255,.6); }
    .brand {
        display:flex; align-items:center; gap:12px; margin-left:auto;
        font-weight:600; letter-spacing:.02em; color:#d7def0;
    }
    .brand-badge{
        width:28px; height:28px; border-radius:50%;
        background: var(--metal); box-shadow: inset 0 0 12px rgba(0,0,0,.35), 0 0 20px rgba(138,123,255,.25);
        border:1px solid rgba(255,255,255,.35);
    }

    /* Hero */
    .hero {
        position:relative; overflow:hidden;
        padding: 56px 24px 24px;
        background: linear-gradient(180deg, rgba(0,208,255,.08), transparent 60%),
                    radial-gradient(900px 600px at 50% -10%, rgba(138,123,255,.12), transparent 60%),
                    var(--bg2);
        border-bottom: 1px solid var(--stroke);
    }
    .hero h1{
        margin:0 0 8px; font-size: clamp(1.6rem, 4.5vw, 2.4rem);
        letter-spacing:.02em;
        text-shadow: 0 2px 16px rgba(0,208,255,.25);
    }
    .hero p{
        margin:0; color:#c9d3e6; max-width: 900px; line-height:1.5;
    }

    /* Section cards */
    .section{
        margin: 20px auto; padding: 20px;
        max-width: 1120px;
    }
    .card{
        position:relative; overflow:hidden;
        background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.03));
        border: 1px solid var(--stroke);
        border-radius: 16px;
        padding: 20px;
        box-shadow: var(--glow);
    }
    .card h2{
        margin:0 0 8px; font-size: clamp(1.2rem, 3.6vw, 1.6rem);
    }
    .card p{ margin: 0 0 10px; color:#d6deef; line-height:1.55; }

    /* Video gallery */
    .gallery{
        display:grid; gap:14px;
        grid-template-columns: repeat(3, minmax(0,1fr));
        margin-top: 12px;
        align-items:start;
    }
    .tile{
        position:relative; overflow:hidden; border-radius:12px;
        background: #0c1118; border: 1px solid var(--stroke);
        display:flex; align-items:center; justify-content:center;
        /* Dejamos que el contenido decida la altura; sin aspect-ratio fijo para permitir verticales */
        padding: 0;
    }
    .tile video{
        width:100%; height:auto; display:block;
        object-fit: cover;   /* por defecto, como antes */
        max-height: var(--max-gallery-video-h);
        background-color:#000; /* “letterbox” cuando contain */
    }
    /* Vídeos verticales o que quieras “sizeToFit” */
    .tile video.portrait,
    .tile video.contain{
        object-fit: contain;
        aspect-ratio: auto; /* que decida el propio vídeo */
    }
    .tile::after{
        content:""; position:absolute; inset:0;
        box-shadow: inset 0 0 40px rgba(0,0,0,.35);
        pointer-events:none;
    }

    /* Full-bleed single video */
    .single{
        margin-top: 12px; border-radius: 12px; overflow:hidden; border:1px solid var(--stroke);
        background:#0c1118;
    }
    .single video{
        width:100%; height:auto; display:block; object-fit: contain;
        max-height: var(--max-single-video-h);
        background:#000;
    }

    /* Footer */
    footer{ padding: 24px; text-align:center; color:#aeb9cd; border-top:1px solid var(--stroke); }

    /* Mobile */
    @media (max-width: 768px){
        .section{ padding:12px; margin:12px auto; }
        .card{ padding:14px; }
        .gallery{ grid-template-columns: 1fr; }
        .back-btn{ padding:8px 12px; font-size:.95rem; }
        .brand{ display:none; }

        /* Limitar aún más la altura en móvil para que siempre quede contenido debajo */
        :root{
            --max-gallery-video-h: 60vh;
            --max-single-video-h: 70vh;
        }
    }
    </style>
</head>
<body>

    <!-- Top bar -->
    <div class="nav">
        <button class="back-btn" onclick="window.history.back()">← Go Back</button>
        <div class="brand">
            <span class="brand-badge"></span>
            The Cargo Lift
        </div>
    </div>

    <!-- Hero -->
    <header class="hero">
        <h1>The Cargo Lift — Spatial UI Prototype</h1>
        <p>
            A collection of spatial interactions, metallic UI treatments and motion prototypes:
            from reactive 3D models and stellar maps to inventory systems and custom loaders.
            All clips were recorded from working prototypes built on Apple platforms.
        </p>
    </header>

    <!-- Overview -->
    <section class="section">
        <div class="card">
            <h2>Highlights</h2>
            <p>Stellar maps built at low level, two‑finger rotation as a starship wheel, SpriteKit particles, reactive 3D assets that respond to device motion and speed, layered transitions for depth, discovery flows device state synchronization (Mac+iPhone reactive through silent notifications) and a resource/timer system.</p>
        </div>
    </section>

    <!-- Gallery grid -->
    <section class="section">
        <div class="card">
            <h2>Gallery</h2>
            <div class="gallery">
                <!-- TIP: place these files in Public/Videos with these names -->
                <div class="tile">
                    <video controls playsinline preload="metadata" class="contain">
                        <source src="/Videos/2dStellarMapConstruidoABajoNivel.mp4" type="video/mp4">
                    </video>
                </div>
                <div class="tile">
                    <video controls playsinline preload="metadata" class="contain">
                        <source src="/Videos/2FingerRotationGestureTestAsAStarshipWheel+SpriteKitParticlesEffectsSimulatingStars.mp4" type="video/mp4">
                    </video>
                </div>
                <div class="tile">
                    <video controls playsinline preload="metadata" class="contain">
                        <source src="/Videos/3dModelReactiveToMobileSpeedAndRotation.mp4" type="video/mp4">
                    </video>
                </div>
                <div class="tile">
                    <video controls playsinline preload="metadata" class="contain">
                        <source src="/Videos/ObjectTransition3dModelAnd2dViewLayeredToCreateDepthEffects.mp4" type="video/mp4">
                    </video>
                </div>
                <div class="tile">
                    <video controls playsinline preload="metadata" class="contain">
                        <source src="/Videos/PlanetDiscoverySpaceTravelDrawing.mp4" type="video/mp4">
                    </video>
                </div>
                <div class="tile">
                    <video controls playsinline preload="metadata" class="contain">
                        <source src="/Videos/SpaceStyleInventoryListWithDynamicDataLoading.mp4" type="video/mp4">
                    </video>
                </div>
            </div>
        </div>
    </section>

    <!-- Single wides -->
    <section class="section">
        <div class="card">
            <h2>Custom Loader</h2>
            <div class="single">
                <video controls playsinline preload="metadata" class="contain">
                    <source src="/Videos/CustomLoader.mp4" type="video/mp4">
                </video>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="card">
            <h2>Summary — Inventory, Stellar Map & Alerts</h2>
            <div class="single">
                <video controls playsinline preload="metadata" class="contain">
                    <source src="/Videos/SummaryVideoWithInventoryStellarMapTravelAlertSummariesResourceReceiveAndTimerActivationWaitingForTheNextResource.mp4" type="video/mp4">
                </video>
            </div>
        </div>
    </section>

    <footer>
        © 2024 The Cargo Lift — Spatial Prototype
    </footer>

</body>
</html>
